{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "margin-bottom": 0,
    "modules-left": [
      "hyprland/workspaces",
      "cpu",
      "memory"
    ],
    "modules-center": [],
    "modules-right": [
      "tray",
      "hyprland/language",
      "pulseaudio",
      "backlight",
      "battery",
      "network",
      "clock",
      "custom/power-menu"
    ],
    "hyprland/workspaces": {
      "disable-scroll": true,
      "all-outputs": true,
      "on-click": "activate",
      "format": "{icon}",
      "format-icons": {
        "active": "●",
        "default": "○"
      }
    },
    "cpu": {
      "interval": 2,
      "format": "CPU {usage}%",
      "tooltip": false
    },
    "memory": {
      "interval": 2,
      "format": "RAM {percentage}%",
      "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },
    "tray": {
      "icon-size": 16,
      "spacing": 10
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "󰂯 {icon}",
        "format-bluetooth-muted": "󰂯  ",
        "format-muted": " ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc} | {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "hyprland/language": {
        "format": "ES",
        "format-en": "US",
        "keyboard-name": "at-translated-set-2-keyboard"
    },
    "backlight": {
        "format": "{icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip-format": "{percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
      "states": {
        "warning": 15,
        "critical": 5
      },
      "format": "{icon}",
      "format-charging": "󰂄",
      "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "tooltip-format": "{capacity}% | {timeTo}"
    },
    "network": {
      "format": "{icon}",
      "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "format-disconnected": "󰤭",
      "format-ethernet": "󰈀",
      "tooltip-format-wifi": "{essid} | {signalStrength}%",
      "tooltip-format-ethernet": "{ifname}",
      "on-click": "nm-connection-editor"
    },
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "{:%A, %B %d, %Y}"
    },
    "custom/power-menu": {
      "format": "⏻",
      "tooltip": false,
      "on-click": "~/.config/waybar/scripts/power-menu/powermenu.sh"
    }
}
